    {
      "id": "pR1pX372_db__uYAH5RDN",
      "type": "text",
      "x": 1300.1026245934722,
      "y": 2434.93179598131,
      "width": 865.9941677654239,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "hachure",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1M",
      "roundness": null,
      "seed": 60959499,
      "version": 667,
      "versionNonce": 1788682597,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792385475628,
      "created": 1792385191830,
      "link": null,
      "locked": false,
      "text": "虽然底部窗口区域不允许上下分栏，但是允许在分栏的窗口中继续布局的。\n并且分栏窗口中的子窗口拖放，仅作用于本身，而不是作用于底部栏的所有窗口。\n(顶部栏和侧边栏同理，只不过侧边栏一级只允许上下分栏，二级子窗口中允许继续添加子窗口)",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "虽然底部窗口区域不允许上下分栏，但是允许在分栏的窗口中继续布局的。\n并且分栏窗口中的子窗口拖放，仅作用于本身，而不是作用于底部栏的所有窗口。\n(顶部栏和侧边栏同理，只不过侧边栏一级只允许上下分栏，二级子窗口中允许继续添加子窗口)",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "nlr-thj-6z2-zQ_YxmGcG",
      "type": "text",
      "x": -1732.5788332058307,
      "y": 6499.321977494088,
      "width": 260,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "hachure",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
