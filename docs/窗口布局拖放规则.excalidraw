      "index": "b1N",
      "roundness": null,
      "seed": 552904517,
      "version": 361,
      "versionNonce": 488628581,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1792393126984,
      "created": 1792392631137,
      "link": null,
      "locked": false,
      "text": "分组拖放的逻辑是，编辑区域",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "分组拖放的逻辑是，编辑区域",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
