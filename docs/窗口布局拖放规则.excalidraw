      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "uWBU8LzPIBPA_kCDWHUWJ",
      "type": "text",
      "x": 606,
      "y": 401.5,
      "width": 180,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aF",
      "roundness": null,
      "seed": 1354311877,
      "version": 270,
      "versionNonce": 10584427,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792371451526,
      "created": 1792371324702,
      "link": null,
      "locked": false,
      "text": "因为窗口1和窗口2\n是在同一侧的，所\n以拖动后，应该将\n窗口1和2同时放置\n到编辑区域的左侧，\n并且移动后保持窗\n口1和2的宽度不变",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "因为窗口1和窗口2\n是在同一侧的，所\n以拖动后，应该将\n窗口1和2同时放置\n到编辑区域的左侧，\n并且移动后保持窗\n口1和2的宽度不变",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
