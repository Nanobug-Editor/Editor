{
  "id": "canvas-flow",
  "name": "Canvas flow acceptance",
  "version": "1.2.0",
  "protocol": 7,
  "api": {"base":"^1", "required":{"ui.native":"^1", "ui.panels":"^1", "ui.canvas":">=1.9,<2", "ui.viewport":"^1", "ui.collections":"^1", "ui.clipboard":">=1.1,<2", "ui.transfer":"^1"}},
  "scope": "workspace",
