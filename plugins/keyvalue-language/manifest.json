{
  "id": "keyvalue-language", "name": "Key-value Language", "version": "0.1.0", "protocol": 7,
  "api": {"base": "^1", "required": {"editor.edit": "^1.1", "language.lsp": "^1.4", "process": "^1", "dependencies": "^1", "workspace.files": "^1.3"}},
  "contributions": "plugin.toml", "component": "keyvalue-language.wasm",
  "permissions": ["editor.read", "editor.write", "workspace.read", "process.service.analysis", "dependencies.prepare"],
