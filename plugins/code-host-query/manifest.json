{
  "id": "code-host-query",
  "name": "代码托管查询",
  "version": "0.1.1",
  "protocol": 7,
  "api": {
    "base": "^1",
    "required": {
      "package.assets": "^1",
      "network.http": "^1",
      "storage.secrets": "^1",
      "lifecycle.timers": "^1",
      "storage.private": "^1.2",
      "ui.interaction": "^1",
      "ui.native": "^1"
    }
  },
  "component": "code-host-query.wasm",
  "permissions": [
    "assets.read",
    "network.http",
    "network.http:http://127.0.0.1:18906",
    "network.http:http://127.0.0.1:18907",
    "secrets",
    "storage",
    "ui.interaction"
  ],
  "storage_limit": 1048576,
  "panels": [
    {
      "id": "cloud",
      "title": "代码托管查询",
      "position": "right"
    }
  ],
  "commands": [
    {
      "id": "set-token",
      "title": "安全输入密钥 / Set token",
      "menu": true
    },
    {
      "id": "delete-token",
      "title": "删除密钥 / Delete token",
      "menu": true
    },
    {
      "id": "query",
      "title": "代码托管查询 / Code hosting query",
      "menu": true
    },
    {
      "id": "refresh",
      "title": "合并刷新 / Refresh",
      "menu": true
    },
    {
      "id": "cancel",
      "title": "取消查询 / Cancel query",
      "menu": true
    },
    {
      "id": "read-cache",
      "title": "读取缓存 / Read cache",
      "menu": true
    },
    {
      "id": "probe",
      "title": "契约诊断 / Contract probe",
      "menu": false
    }
  ]
}
